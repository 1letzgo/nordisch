# Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
*.csproj
*.sln
*.pidb
*.userprefs
*.apk
*.aab
*.ipa
.vs/
.idea/
.vscode/
# macOS
.DS_Store
# Python
__pycache__/
*.pyc

# Xcode
xcuserdata/

# Generated by the importer (100 MB+, rebuilt from Data/ with ImportAllBatch)
/Assets/Generated/*/*_meshes.asset
/Assets/Generated/*/*_meshes.asset.meta
# Release-only expiry file (BuildScript.BuildAndroidRelease)
/Assets/Resources/BuildInfo.txt
/Assets/Resources/BuildInfo.txt.meta
# Unity crash dumps / tooling
mono_crash.*
/.utmp/
/Assets/Generated/*/*_facade.bytes
/Assets/Generated/*/*_facade.bytes.meta
/Assets/Generated/*/tiles/
/Assets/Generated/*/tiles.meta

# Agent worktrees
/.claude/worktrees/

# Large rasters (aerial image, terrain) – re-create with Tools/dop/fetch_dop.py and Tools/dgm/fetch_dgm.py
/Data/*.dop.png
/Data/*.dgm.bin
/Assets/Generated/*/regions~/
/Assets/Generated/*/build~/
