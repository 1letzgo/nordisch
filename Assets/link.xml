<!--
  Engine code stripping only sees the menu scene: everything the downloaded map bundles use must be kept here.
  GameObject.CreatePrimitive adds colliders at runtime (seen on Android); map scenes use mesh/box colliders, TextMesh
  street signs, lights. Our own scripts (AreaInfo, TrafficLights, FacadeDetails …) live only in map scenes.
-->
<linker>
  <assembly fullname="UnityEngine.PhysicsModule">
    <type fullname="UnityEngine.CapsuleCollider" preserve="all"/>
    <type fullname="UnityEngine.SphereCollider" preserve="all"/>
    <type fullname="UnityEngine.BoxCollider" preserve="all"/>
    <type fullname="UnityEngine.MeshCollider" preserve="all"/>
  </assembly>
  <assembly fullname="UnityEngine.TextRenderingModule" preserve="all"/>
  <assembly fullname="UnityEngine.CoreModule">
    <type fullname="UnityEngine.Light" preserve="all"/>
    <type fullname="UnityEngine.MeshRenderer" preserve="all"/>
    <type fullname="UnityEngine.MeshFilter" preserve="all"/>
    <type fullname="UnityEngine.Mesh" preserve="all"/>
    <type fullname="UnityEngine.TextAsset" preserve="all"/>
  </assembly>
  <assembly fullname="Assembly-CSharp" preserve="all"/>
</linker>
